+def merge_targets(targets, support, cap, policy='input-order'):
+    """Rank merged run-type candidates by training support, never by future data.
+
+    Support is sum(run_count * target marginal probability) over assigning types,
+    not P(miss|site) or a measured runtime prediction-accuracy estimate.
+    """
+    unique = {}; order = []
+    for target in targets:
+        key = (target[4], target[3])
+        if key not in unique:
+            unique[key] = target; order.append(key)
+    if policy != 'input-order':
+        def score(key):
+            target = unique[key]
+            cost = (15 if target[2] else 7) if policy == 'byte-efficiency' else 1
+            return support.get(key, 0) / cost
+        order.sort(key=lambda key: (-score(key), key))
+    return [unique[key] for key in order[:cap]]
+
