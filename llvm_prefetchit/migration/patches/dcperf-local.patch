+void DriverNode::DriverNodeImpl::MonitoringCompletionTotalsHandler(
+    evhttp_request* req, void* arg) {
+  DriverNode* driver = reinterpret_cast<DriverNode*>(arg);
+  if (evhttp_request_get_command(req) != EVHTTP_REQ_GET) {
+    evhttp_send_error(req, HTTP_BADREQUEST, 0);
+    return;
+  }
+  evbuffer* evb = evbuffer_new();
+  if (evb == nullptr) {
+    evhttp_send_error(req, HTTP_SERVUNAVAIL, 0);
+    return;
+  }
+  evbuffer_add_printf(evb, "request_type,sent,completed\n");
+  for (uint32_t type : driver->impl_->request_types) {
+    evbuffer_add_printf(
+        evb, "%u,%lu,%lu\n", type,
+        driver->impl_->total_child_stats->query_counts_.at(type),
+        driver->impl_->total_child_stats->query_samplers_.at(type).total());
+  }
+  evhttp_send_reply(req, 200, "OK", evb);
+  evbuffer_free(evb);
+}
