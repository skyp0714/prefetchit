diff --git a/src/include/executor/executor.h b/src/include/executor/executor.h
index baef7e0..dc130ba 100644
--- a/src/include/executor/executor.h
+++ b/src/include/executor/executor.h
@@ -274,6 +274,14 @@ ExecProcNode(PlanState *node)
 	if (node->chgParam != NULL) /* something changed? */
 		ExecReScan(node);		/* let ReScan handle this */
 
+#ifdef PREFETCHIT_EXEC_PROC_NODE
+	__builtin_prefetch((const void *) node->ExecProcNode, 0, 3);
+	if (node->lefttree != NULL)
+		__builtin_prefetch((const void *) node->lefttree->ExecProcNode, 0, 3);
+	if (node->righttree != NULL)
+		__builtin_prefetch((const void *) node->righttree->ExecProcNode, 0, 3);
+#endif
+
 	return node->ExecProcNode(node);
 }
 #endif
