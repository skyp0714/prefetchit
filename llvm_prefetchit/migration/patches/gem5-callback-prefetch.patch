+
+      template <typename Target>
+      static const void *
+      memberFunctionTarget(Target target)
+      {
+          const void *result = nullptr;
+          std::memcpy(&result, &target, std::min(sizeof(result), sizeof(target)));
+          return result;
+      }
+
+      template <typename Callback>
+      static const void *
+      callbackPrefetchTarget(const Callback &callback)
+      {
+          using CallbackType = std::decay_t<Callback>;
+          if constexpr (
+              std::is_pointer_v<CallbackType> &&
+              std::is_function_v<std::remove_pointer_t<CallbackType>>) {
+              return reinterpret_cast<const void *>(callback);
+          } else if constexpr (std::is_member_function_pointer_v<CallbackType>) {
+              return memberFunctionTarget(callback);
+          } else if constexpr (HasCallOperator<CallbackType>::value) {
+              return memberFunctionTarget(&CallbackType::operator());
+          } else {
+              return nullptr;
+          }
+      }
