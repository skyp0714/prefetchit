diff --git a/src/hotspot/cpu/x86/x86_64.ad b/src/hotspot/cpu/x86/x86_64.ad
index 02618bf2d..78730e4c5 100644
--- a/src/hotspot/cpu/x86/x86_64.ad
+++ b/src/hotspot/cpu/x86/x86_64.ad
@@ -444,6 +444,30 @@ static int clear_avx_size() {
   return generate_vzeroupper(Compile::current()) ? 3: 0;  // vzeroupper
 }
 
+// prefetchit V1: bytes and emission for the optional prefetcht1 of the
+// return-target code lines emitted immediately before Java calls.
+// Each prefetcht1 [rip+disp32] is 7 bytes: 0F 18 /2 disp32.
+static int prefetch_ret_bytes() {
+  return PrefetchRetTarget ? 7 * (int)PrefetchRetTargetLines : 0;
+}
+
+// tail_bytes = bytes remaining in this node after the prefetch sequence up
+// to and including the call (i.e. return address == insts_end() after the
+// prefetches + tail_bytes).
+static void emit_prefetch_ret(CodeBuffer &cbuf, int tail_bytes) {
+  if (!PrefetchRetTarget) return;
+  int n = (int)PrefetchRetTargetLines;
+  for (int j = 0; j < n; j++) {
+    int remaining = 7 * (n - j - 1); // prefetches still to be emitted
+    // rip-relative disp counts from the end of this prefetch instruction
+    int disp = remaining + tail_bytes + 64 * j;
+    cbuf.insts()->emit_int8((unsigned char)0x0F);
+    cbuf.insts()->emit_int8((unsigned char)0x18);
+    cbuf.insts()->emit_int8((unsigned char)0x15); // modrm /2 = t1, rip-rel
+    cbuf.insts()->emit_int32(disp);
+  }
+}
+
 // !!!!! Special hack to get all types of calls to specify the byte offset
 //       from the start of the call to the point where the return address
 //       will point.
@@ -451,6 +475,7 @@ int MachCallStaticJavaNode::ret_addr_offset()
 {
   int offset = 5; // 5 bytes from start of call to where return address points
   offset += clear_avx_size();
+  offset += prefetch_ret_bytes();
   return offset;
 }
 
@@ -458,6 +483,7 @@ int MachCallDynamicJavaNode::ret_addr_offset()
 {
   int offset = 15; // 15 bytes from start of call to where return address points
   offset += clear_avx_size();
+  offset += prefetch_ret_bytes();
   return offset;
 }
 
@@ -483,6 +509,7 @@ int MachCallNativeNode::ret_addr_offset() {
 int CallStaticJavaDirectNode::compute_padding(int current_offset) const
 {
   current_offset += clear_avx_size(); // skip vzeroupper
+  current_offset += prefetch_ret_bytes(); // skip prefetchit V1 prefetches
   current_offset += 1; // skip call opcode byte
   return align_up(current_offset, alignment_required()) - current_offset;
 }
@@ -492,6 +519,7 @@ int CallStaticJavaDirectNode::compute_padding(int current_offset) const
 int CallDynamicJavaDirectNode::compute_padding(int current_offset) const
 {
   current_offset += clear_avx_size(); // skip vzeroupper
+  current_offset += prefetch_ret_bytes(); // skip prefetchit V1 prefetches
   current_offset += 11; // skip movq instruction + call opcode byte
   return align_up(current_offset, alignment_required()) - current_offset;
 }
@@ -2138,6 +2166,7 @@ encode %{
     // JAVA STATIC CALL
     // CALL to fixup routine.  Fixup routine uses ScopeDesc info to
     // determine who we intended to call.
+    emit_prefetch_ret(cbuf, 5); // prefetchit V1: E8+disp32 remain after us
     cbuf.set_insts_mark();
     $$$emit8$primary;
 
@@ -2162,6 +2191,8 @@ encode %{
   %}
 
   enc_class Java_Dynamic_Call(method meth) %{
+    // prefetchit V1: movq rax,imm64 (10) + call (5) remain after us
+    emit_prefetch_ret(cbuf, 15);
     MacroAssembler _masm(&cbuf);
     __ ic_call((address)$meth$$method, resolved_method_index(cbuf));
   %}
